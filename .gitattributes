# 统一换行符处理
* text=auto

# 明确指定某些文件类型使用LF换行符
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不进行换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.pak binary
*.dat binary

# 强制某些文件使用特定换行符（如果需要）
package.json text eol=lf
README.md text eol=lf