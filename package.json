{
  "name": "music-player",
  "productName": "MusicPlayer",
  "version": "1.3.0",
  "description": "A simple music player",
  "author": "AH23333",
  "license": "MIT",
  "homepage": "https://github.com/AH23333/MusicPlayer",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "sync-app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-to-packaged.ps1",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "autoprefixer": "^10.4.27",
    "electron": "^28.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "MusicPlayer",
        "executableName": "MusicPlayer",
        "icon": "assets/icon.ico",
        "extraResource": [
          "music-dl-api.exe"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "music_player",
            "authors": "AH23333",
            "description": "A simple music player",
            "setupIcon": "assets/icon.ico",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
          }
        }
      ]
    }
  }
}
